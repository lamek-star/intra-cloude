# Private Data Cloud — Environment Configuration Template
#
# Copy this file to `.env` and fill in real, locally generated values.
# NEVER commit `.env`. Every value below is a placeholder.
#
# Note: docker-compose.yml explicitly sets DJANGO_SETTINGS_MODULE per
# service (config.settings.prod for backend/worker/beat), overriding
# whatever is in this file for containers. `manage.py` defaults to
# config.settings.dev when run directly (no Docker) if unset.

# --- Django ---
SECRET_KEY=changeme-generate-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost:8443
CORS_ALLOWED_ORIGINS=https://localhost:8443

# Dedicated key for encrypting ConnectedDatabase credentials at rest.
# Distinct from SECRET_KEY. Losing this key makes stored external-database
# credentials unrecoverable — back it up per docs/operations/BACKUP_RESTORE.md.
CREDENTIAL_ENCRYPTION_KEY=changeme-generate-a-separate-long-random-value

# --- Control-plane PostgreSQL ---
CONTROL_DB_NAME=pdc_control
CONTROL_DB_USER=pdc_control_app
CONTROL_DB_PASSWORD=changeme
CONTROL_DB_HOST=postgres-control
CONTROL_DB_PORT=5432

# --- Tenant PostgreSQL ---
TENANT_DB_NAME=pdc_tenant
TENANT_DB_USER=pdc_tenant_app
TENANT_DB_PASSWORD=changeme
TENANT_DB_HOST=postgres-tenant
TENANT_DB_PORT=5432
# Optional: after running `python manage.py provision_tenant_role` (Phase 11
# hardening, docs/security/THREAT_MODEL.md TB3), point TENANT_DB_USER/
# TENANT_DB_PASSWORD at the new least-privilege role's credentials instead
# of the bootstrap superuser above.

# Server-side upper bound (milliseconds) on any single SQL statement, on
# both the control-plane and tenant connections (Phase 11 hardening).
DB_STATEMENT_TIMEOUT_MS=60000

# --- Valkey (Redis-protocol-compatible broker/cache — see ADR-0011) ---
# Variable name kept as REDIS_URL for client-library familiarity
# (redis-py/Celery both just speak the protocol; the server is Valkey).
REDIS_URL=redis://valkey:6379/0

# --- Object Storage (S3-compatible / MinIO locally) ---
OBJECT_STORAGE_ENDPOINT=http://object-storage:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ROOT_USER=changeme
OBJECT_STORAGE_ROOT_PASSWORD=changeme
OBJECT_STORAGE_BUCKET_PREFIX=pdc

# Upper bound (bytes) on any single file upload. Default 2 GiB.
MAX_UPLOAD_SIZE_BYTES=2147483648

# --- Malware scanning (off by default — see docker-compose.yml's
# `clamav` service, started only via `--profile malware-scan`) ---
MALWARE_SCAN_ENABLED=False
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# --- Analytics ---
# Upper bound on how many rows any single analytics operation pulls
# into Python/numpy/scipy. Default 200,000.
ANALYTICS_MAX_ROWS=200000

# --- Connected-database SSRF guard ---
# Off by default: loopback and RFC1918 private ranges are allowed
# (a customer's own on-prem PostgreSQL, or in local dev the tenant DB
# itself, legitimately lives there). Link-local (cloud metadata) is
# always blocked regardless of this setting. Turn this on for a
# hosted/multi-tenant topology where "private network" might mean the
# host's own internal Docker network, which tenants must not reach.
CONNECTED_DATABASE_BLOCK_PRIVATE_NETWORKS=False

# --- Reverse proxy ---
# LAN interface IP the proxy binds to (never 0.0.0.0 on a host with a public
# interface). Use 127.0.0.1 for local-only single-machine access.
PROXY_BIND_ADDRESS=127.0.0.1
# Space-separated hostnames/IPs Caddy's internal CA issues a certificate
# for. Must include every name you'll actually use to reach the proxy —
# add your LAN IP here if accessing from another machine on the network.
PROXY_TLS_HOSTNAMES=localhost 127.0.0.1
# Only used by infrastructure/proxy/Caddyfile.internet-gateway (Phase 10,
# docs/deployment/INTERNET_GATEWAY.md) — not the default Caddyfile above.
# PROXY_DOMAIN=example.com
# PROXY_ACME_EMAIL=admin@example.com

# --- Feature flags (secure defaults: off) ---
FEATURE_EXTERNAL_SHARING_ENABLED=False
FEATURE_INTERNET_GATEWAY_ENABLED=False

# --- Backups (Phase 11; docs/operations/BACKUP_RESTORE.md) ---
# Where system/backups.py writes pg_dump output. Mounted as a named
# Docker volume by default (docker-compose.yml, service: backend/worker/
# beat) — point its backing storage at off-host/NAS media in production;
# a local volume alone is not itself an off-host backup.
BACKUP_DIR=/backups
# Optional (Phase 15): when set, every backup (control DB, tenant DB,
# object storage, configuration) is encrypted at rest. Required for
# configuration backups to include real secret values instead of
# redacted placeholders. Store this key somewhere OTHER than this
# server/BACKUP_DIR (a password manager, not a file next to the
# backups it protects) — losing it makes every encrypted backup
# permanently unrecoverable, and it cannot be recovered from a
# configuration backup, since that backup is itself encrypted with it.
# BACKUP_ENCRYPTION_KEY=changeme-generate-a-separate-long-random-value
