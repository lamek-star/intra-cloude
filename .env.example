# Private Data Cloud — Environment Configuration Template
#
# Copy this file to `.env` and fill in real, locally generated values.
# NEVER commit `.env`. Every value below is a placeholder.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=changeme-generate-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost:8443

# Dedicated key for encrypting ConnectedDatabase credentials at rest.
# Distinct from SECRET_KEY. Losing this key makes stored external-database
# credentials unrecoverable — back it up per docs/operations/BACKUP_RESTORE.md.
CREDENTIAL_ENCRYPTION_KEY=changeme-generate-a-separate-long-random-value

# --- Control-plane PostgreSQL ---
CONTROL_DB_NAME=pdc_control
CONTROL_DB_USER=pdc_control_app
CONTROL_DB_PASSWORD=changeme
CONTROL_DB_HOST=postgres-control
CONTROL_DB_PORT=5432

# --- Tenant PostgreSQL ---
TENANT_DB_NAME=pdc_tenant
TENANT_DB_USER=pdc_tenant_app
TENANT_DB_PASSWORD=changeme
TENANT_DB_HOST=postgres-tenant
TENANT_DB_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object Storage (S3-compatible / MinIO locally) ---
OBJECT_STORAGE_ENDPOINT=http://object-storage:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ROOT_USER=changeme
OBJECT_STORAGE_ROOT_PASSWORD=changeme
OBJECT_STORAGE_BUCKET_PREFIX=pdc

# --- Reverse proxy ---
# LAN interface IP the proxy binds to (never 0.0.0.0 on a host with a public
# interface). Use 127.0.0.1 for local-only single-machine access.
PROXY_BIND_ADDRESS=127.0.0.1

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=https://localhost:8443/api/v1

# --- Feature flags (secure defaults: off) ---
FEATURE_EXTERNAL_SHARING_ENABLED=False
FEATURE_INTERNET_GATEWAY_ENABLED=False
