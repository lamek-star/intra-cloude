<UserControl x:Class="IntraCloud.ControlCenter.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Distribution state: " FontWeight="Bold" />
            <TextBlock Text="{Binding DistroState}" />
            <TextBlock Text="  |  " Foreground="Gray" />
            <TextBlock Text="Healthy: " FontWeight="Bold" />
            <TextBlock Text="{Binding Healthy}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,0,0,8" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Start" Command="{Binding StartCommand}" Margin="0,0,8,0" Padding="12,4" />
            <Button Content="Stop" Command="{Binding StopCommand}" Margin="0,0,8,0" Padding="12,4" />
            <Button Content="Restart" Command="{Binding RestartCommand}" Margin="0,0,8,0" Padding="12,4" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="12,4" />
            <TextBlock Text="{Binding LastCheckedAt, StringFormat='Last checked: {0:T}'}"
                       VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray" FontSize="11" />
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Services}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="*" />
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" />
                <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
