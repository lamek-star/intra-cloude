<UserControl x:Class="IntraCloud.ControlCenter.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="16" MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Text="Backup destination" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBox Text="{Binding BackupDestination, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="4" />

        <CheckBox Content="Verbose logging" IsChecked="{Binding VerboseLogging}" Margin="0,0,0,12" />

        <TextBlock Text="Status auto-refresh interval (seconds)" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBox Text="{Binding StatusRefreshIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="4" Width="80" HorizontalAlignment="Left" />

        <Button Content="Save" Command="{Binding SaveCommand}" Padding="12,4" HorizontalAlignment="Left" Margin="0,0,0,8" />
        <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
