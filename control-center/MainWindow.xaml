<Window x:Class="IntraCloud.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IntraCloud.ControlCenter.Views"
        Title="Intra-Cloud Control Center"
        Height="560" Width="820"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,12,16,0">
            <TextBlock Text="INTRA-CLOUD" FontSize="18" FontWeight="Bold" Margin="0,0,12,0" />
            <TextBlock x:Name="VersionText" VerticalAlignment="Bottom" Foreground="Gray" />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="8">
            <TabItem Header="Status">
                <views:StatusView DataContext="{Binding Status}" />
            </TabItem>
            <TabItem Header="Backup &amp; Restore">
                <views:BackupView DataContext="{Binding Backup}" />
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
            <TabItem Header="Logs &amp; Diagnostics">
                <views:LogsView DataContext="{Binding Logs}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
