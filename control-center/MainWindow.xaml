<Window x:Class="IntraCloud.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intra-Cloud Control Center"
        Height="220" Width="360"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="INTRA-CLOUD" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
        <TextBlock Text="Control Center — build-infrastructure placeholder"
                   TextWrapping="Wrap" Margin="0,0,0,12" Foreground="Gray" />
        <TextBlock x:Name="VersionText" Margin="0,0,0,4" />
        <TextBlock Text="Real system status, start/stop/restart, and backup/restore controls land in Phase 18."
                   TextWrapping="Wrap" FontSize="11" Foreground="Gray" />
    </StackPanel>
</Window>
