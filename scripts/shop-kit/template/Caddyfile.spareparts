
# The spare parts reference application (a separate Next.js project bundled as its own container): plain HTTP, published ONLY on the
# loopback address (127.0.0.1:SHOP_SPAREPARTS_PORT, default 3000), so it is reachable from this PC alone.
http://:3000 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
	}

	reverse_proxy spareparts:3000
}
